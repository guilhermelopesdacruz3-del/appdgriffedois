{
  "name": "appdgriffedois",
  "description": "D'Griffe Ótica backend API (Express)",
  "repo": "guilhermelopesdacruz3-del/appdgriffedois.git",
  "branch": "main",
  "type": "node",
  "framework": "express",
  "build_command": "npm run build",
  "start_command": "node dist/index.js",
  "env": [
    { "key": "NODE_ENV", "value": "production" },
    { "key": "PORT", "value": "8787" },
    { "key": "ADMIN_PASSWORD", "value": "CONFIGURE_NO_PAINEL", "secret": true },
    { "key": "ADMIN_SECRET", "value": "CONFIGURE_NO_PAINEL", "secret": true },
    { "key": "DEMO_MODE", "value": "false" },
    { "key": "LOJA_INTEGRADA_API_KEY", "value": "CONFIGURE_NO_PAINEL", "secret": true },
    { "key": "LOJA_INTEGRADA_APP_KEY", "value": "CONFIGURE_NO_PAINEL", "secret": true },
    { "key": "LOJA_INTEGRADA_API_BASE_URL", "value": "https://api.awsli.com.br/api/v1" },
    { "key": "FRONTEND_ORIGIN", "value": "https://dgriffe-site.pages.dev" },
    { "key": "SUPABASE_URL", "value": "CONFIGURE_NO_PAINEL", "secret": true },
    { "key": "SUPABASE_SERVICE_ROLE", "value": "CONFIGURE_NO_PAINEL", "secret": true }
  ],
  "databases": [
    {
      "name": "dgriffe-db",
      "version": "postgresql",
      "plan": "hobby"
    }
  ],
  "build": {
    "dockerfile": "Dockerfile",
    "context": "./"
  }
}