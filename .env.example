# Cloudflare Pages Deploy
# Copie este arquivo para .env e preencha com seus valores reais.
# Nunca commite este arquivo com credenciais reais.

CLOUDFLARE_ACCOUNT_ID=seu_account_id_aqui
CLOUDFLARE_API_TOKEN=seu_cfat_token_aqui
CLOUDFLARE_ACCESS_KEY_ID=sua_access_key_id_aqui
CLOUDFLARE_SECRET_ACCESS_KEY=sua_secret_key_aqui
CLOUDFLARE_R2_ENDPOINT=https://seu-account.r2.cloudflarestorage.com
CLOUDFLARE_PAGES_PROJECT=appdgriffedois